# Copy this file to .env and fill in real values -- or don't. .env is
# gitignored -- never commit it. This is a PUBLIC repo.
#
# EVERYTHING in this file is now OPTIONAL. The container boots with zero
# environment variables set at all: it comes up "unconfigured", prints a
# first-boot admin password to the logs, and every setting below (including
# the LINE credentials and the Microsoft/Entra block) is configurable from
# the admin UI at http://<pi-address>:8001 instead. This file exists only
# for anyone who'd rather configure the bot headlessly over SSH and never
# open the UI at all -- whatever you leave unset here stays configurable in
# the UI, and a value set in the UI takes precedence over what's here. See
# README.md "Setup" for the UI-first walkthrough, and "Web admin UI" for the
# DB > env > default precedence this file participates in.

# --- LINE ---
# From the LINE Developers console (Messaging API channel).
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# The LINE group id the lab posts photos into. NOT visible anywhere in the
# LINE console. Leave this unset on first boot, add the bot to the group,
# have someone post any message, then read the groupId out of the server
# logs ("Message event seen: groupId=..."), or use the admin UI's Setup >
# LINE > "Detect group" button, and paste/save it here. Until this is set
# the bot processes nothing (fail safe).
LINE_LAB_GROUP_ID=

# Optional: a LINE user id (your own) to receive admin push notifications
# (unfiled results, OneDrive re-auth needed). Leave blank to disable.
ADMIN_LINE_ID=

# --- OCR backend ---
# One of: claude | gemini | tesseract. Default: tesseract -- needs no
# credentials at all, so this is the only backend the container can use
# with zero configuration. Only the selected backend's credentials below
# are required (and only once you switch to it).
OCR_BACKEND=tesseract

# claude backend (official Anthropic SDK)
CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# gemini backend (google-genai SDK). GEMINI_MODEL is not hardcoded in code --
# list currently valid model ids for your API key with:
#   python -c "from google import genai; [print(m.name) for m in genai.Client(api_key='...').models.list()]"
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# tesseract backend: no credentials needed, runs fully offline. Requires the
# tesseract-ocr and tesseract-ocr-tha system packages (already in Dockerfile).

# --- OPD number extraction ---
# Applied to the extracted markdown as a cross-check against (or fallback
# for) whatever the LLM backend itself returns. Change this without a code
# change if your lab's reports label the OPD number differently.
#
# The lab's reports carry THREE id numbers and only one is the filing key:
#   HN VET             : 00234654   <- the LAB's patient id  (8 digits)
#   LN VET             : 00350116   <- the LAB's specimen id (8 digits)
#   HN Hospital/Clinic : 8258       <- the CLINIC's id (4 digits) == the OPD number
# Some reports print the last one as "OPD 9654" and some as bare "8258", so
# the prefix is optional in the pattern and the field label does the anchoring.
# The capture is exactly 4 digits, so the lab's 8-digit ids can never match --
# do not loosen that without re-checking against real reports.
OPD_REGEX=(?i)\b(?:HN\s*Hospita.{0,4}Clinic|OPD|O\.?P\.?D\.?)\s*(?:no\.?|number|เลขที่)?\s*[:.#\-]?\s*\|?\s*(?:OPD\s*)?([0-9]{4})\b

# --- Filing ---
# IANA timezone used to compute the "received date" folder/filename from the
# LINE event timestamp (NOT server local time).
TIMEZONE=Asia/Bangkok

# Root folder path in the target OneDrive, under which per-OPD subfolders
# (and _UNFILED/<date>/) are created.
ONEDRIVE_ROOT=/LabResults

# --- Microsoft Entra ID / OneDrive OAuth ---
# App registration ID (Applications > App registrations), set to
# "Personal Microsoft accounts only" as its supported account type.
MS_CLIENT_ID=your-entra-application-client-id

# The public HTTPS URL this service is reachable at through your tunnel
# (e.g. https://abc123.trycloudflare.com), NO trailing slash. The app
# derives both of the following from it:
#   OAuth redirect URI:  {PUBLIC_BASE_URL}/oauth/callback?secret={OAUTH_SETUP_SECRET}
#   LINE webhook URL:    {PUBLIC_BASE_URL}/line/webhook
# The admin UI's Setup > OneDrive page displays both derived URLs with copy
# buttons once this (and MS_CLIENT_ID) is set -- see README.md "Setup" for
# where each one gets pasted (Entra, and the LINE Developers console).
PUBLIC_BASE_URL=https://your-tunnel-host.example

# Explicit override for the OAuth redirect URI, taking precedence over the
# one derived from PUBLIC_BASE_URL above. Leave unset unless the derived
# value isn't right for your setup -- e.g. a redirect URI that doesn't
# follow the {PUBLIC_BASE_URL}/oauth/callback?secret=... shape. If you do
# set it, it must exactly match a redirect URI registered on the Entra app,
# secret= query string included, e.g.:
#   https://your-tunnel-host.example/oauth/callback?secret=<OAUTH_SETUP_SECRET>
MS_REDIRECT_URI=

# A random secret required as a query param on /oauth/start and
# /oauth/callback, so a stranger who finds your public tunnel URL cannot
# authorize the bot against their own OneDrive account. Leave this UNSET --
# one is generated automatically on first boot and persisted (see README.md
# "Generate the OAuth setup secret"); only set it yourself if you need a
# specific, stable value ahead of time (e.g. to pre-register the Entra
# redirect URI before first boot). Whatever the effective value is, it's
# never rotated automatically -- it's baked into the Entra app
# registration's redirect URI, so changing it breaks sign-in until you
# update Entra to match (the admin UI's Setup > OneDrive page has an
# explicit "Regenerate" button with this warning built in).
OAUTH_SETUP_SECRET=

# --- Storage / misc ---
# Directory for the SQLite database (also holds the admin UI's config table,
# activity log, and the config-encryption/session-secret key files) and the
# MSAL token cache. Matches the ./data volume mount in docker-compose.yml --
# do not change unless you also update the volume mount. NOT settable from
# the admin UI (it's where the UI's own config table lives).
DATA_DIR=data

# NOT settable from the admin UI (a startup-time logging concern).
LOG_LEVEL=INFO

# --- Web admin UI ---
# 'lan' (default): the admin UI (port 8001) is the only place it's reachable
# -- an admin route hit on the public tunnel port (8000) 404s, not a login
# page. 'public': also mount the admin UI on the public port, for setups
# with no LAN access to the Pi. A login is required either way; this only
# controls whether the login page itself is reachable from the internet at
# all. Changing this needs a container restart to take effect (also true if
# you change it from the admin UI's General page instead of here).
SETUP_UI_EXPOSURE=lan

# --- Deploy-time host ports ---
# The HOST side of the Docker port mapping in docker-compose.yml /
# portainer-stack.yml -- uncomment and change ONLY if 8000/8001 are already
# taken by something else on this host. The port INSIDE the container stays
# 8000/8001 either way (hardcoded in app/main.py), so nothing else needs to
# change to match. NOT settable from the admin UI -- these are resolved by
# Docker before the app process even starts. If you remap PUBLIC_PORT, point
# your tunnel at the new port too (`cloudflared tunnel --url
# http://localhost:${PUBLIC_PORT}`); if you remap ADMIN_PORT, the admin UI
# moves to http://<host>:${ADMIN_PORT}.
# PUBLIC_PORT=8000
# ADMIN_PORT=8001

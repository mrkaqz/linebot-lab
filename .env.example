# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. This is a PUBLIC repo.

# --- LINE ---
# From the LINE Developers console (Messaging API channel).
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# The LINE group id the lab posts photos into. NOT visible anywhere in the
# LINE console. Leave this unset on first boot, add the bot to the group,
# have someone post any message, then read the groupId out of the server
# logs ("Message event seen: groupId=..."), and paste it here. Until this
# is set the bot processes nothing (fail safe).
LINE_LAB_GROUP_ID=

# Optional: a LINE user id (your own) to receive admin push notifications
# (unfiled results, OneDrive re-auth needed). Leave blank to disable.
ADMIN_LINE_ID=

# --- OCR backend ---
# One of: claude | gemini | tesseract
# Only the selected backend's credentials below are required.
OCR_BACKEND=tesseract

# claude backend (official Anthropic SDK)
CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# gemini backend (google-genai SDK). GEMINI_MODEL is not hardcoded in code --
# list currently valid model ids for your API key with:
#   python -c "from google import genai; [print(m.name) for m in genai.Client(api_key='...').models.list()]"
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# tesseract backend: no credentials needed, runs fully offline. Requires the
# tesseract-ocr and tesseract-ocr-tha system packages (already in Dockerfile).

# --- OPD number extraction ---
# Applied to the extracted markdown as a cross-check against (or fallback
# for) whatever the LLM backend itself returns. Change this without a code
# change if your lab's reports label the OPD number differently.
OPD_REGEX=(?i)\b(?:OPD|O\.?P\.?D\.?|HN)\s*(?:no\.?|number|เลขที่)?\s*[:.#\-]?\s*([0-9][0-9\-/]{3,})

# --- Filing ---
# IANA timezone used to compute the "received date" folder/filename from the
# LINE event timestamp (NOT server local time).
TIMEZONE=Asia/Bangkok

# Root folder path in the target OneDrive, under which per-OPD subfolders
# (and _UNFILED/<date>/) are created.
ONEDRIVE_ROOT=/LabResults

# --- Microsoft Entra ID / OneDrive OAuth ---
# App registration ID (Applications > App registrations), set to
# "Personal Microsoft accounts only" as its supported account type.
MS_CLIENT_ID=your-entra-application-client-id

# Must exactly match a redirect URI registered on the Entra app, and should
# end in /oauth/callback. Include the OAUTH_SETUP_SECRET below as a query
# string on THIS value (see README.md) so it comes back on Microsoft's
# redirect and /oauth/callback can check it, e.g.:
#   https://your-tunnel-host.example/oauth/callback?secret=<OAUTH_SETUP_SECRET>
MS_REDIRECT_URI=https://your-tunnel-host.example/oauth/callback?secret=change-me

# A random secret required as a query param on /oauth/start and
# /oauth/callback, so a stranger who finds your public tunnel URL cannot
# authorize the bot against their own OneDrive account. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_SETUP_SECRET=change-me

# --- Storage / misc ---
# Directory for the SQLite database and the MSAL token cache. Matches the
# ./data volume mount in docker-compose.yml -- do not change unless you also
# update the volume mount.
DATA_DIR=data

LOG_LEVEL=INFO
